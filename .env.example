# Sao chép thành .env.local rồi sửa. Mọi biến NEXT_PUBLIC_* đều lộ ra trình duyệt: chỉ để thứ công khai.

# Tên site và domain (chưa chốt, đang dùng tạm)
NEXT_PUBLIC_SITE_NAME=TMST
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL của API Go, ví dụ https://api.example.com
# Để TRỐNG = chạy trên mock (MSW handlers trong mocks/)
NEXT_PUBLIC_API_BASE=
# Chỉ dùng cho staging/QA: cho phép ?mock=429|410|500 gửi header X-Mock-Scenario tới API ngoài.
# Production KHÔNG đặt biến này.
NEXT_PUBLIC_MOCK_SCENARIOS=

# Nhà cung cấp quảng cáo: mock | fallback | gpt
NEXT_PUBLIC_AD_PROVIDER=mock
# Google Ad Manager ad unit (owner tạo), ví dụ /1234567/tracuu_rewarded và /1234567/tracuu_banner.
# Chưa có tài khoản: đặt NEXT_PUBLIC_AD_PROVIDER=gpt cùng 2 ad unit THỬ NGHIỆM công khai của Google dưới đây
# để xem quảng cáo mẫu thật (không có doanh thu). Video có thưởng chỉ hiện trên điện thoại; máy tính sẽ
# chuyển sang quảng cáo dự phòng 5 giây (spec 5.1).
#   NEXT_PUBLIC_GPT_AD_UNIT_PATH=/22639388115/rewarded_web_example
#   NEXT_PUBLIC_GPT_BANNER_PATH=/6355419/Travel/Europe
NEXT_PUBLIC_GPT_AD_UNIT_PATH=
NEXT_PUBLIC_GPT_BANNER_PATH=

# Mã publisher Google (pub-…) cho /ads.txt. Chỉ máy chủ đọc, không lộ ra trình duyệt. Trống = /ads.txt trả 404.
GOOGLE_AD_PUBLISHER_ID=

# Cloudflare Turnstile site key (để trống = token giả lập)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Khoá bí mật Turnstile — CHỈ máy chủ đọc. /api/list-pass dùng để kiểm token với Cloudflare trước khi cấp vé mở
# danh sách. Để trống = chấp nhận mọi token (chỉ dùng cho dev / mock).
TURNSTILE_SECRET_KEY=

# Khoá ký «vé» mở danh sách sau quảng cáo (lib/list-gate.js), chuỗi ngẫu nhiên ≥ 32 ký tự, ví dụ: openssl rand -hex 32.
# Để trống = khoá ngẫu nhiên mỗi lần khởi động (vé cũ mất hiệu lực khi deploy lại). Chạy nhiều máy chủ thì BẮT BUỘC đặt.
LIST_GATE_SECRET=

# Ngưỡng chống crawl trang danh sách (lib/list-gate.js). Để trống = mặc định: quá 20 trang / 10 phút mỗi IP → xác minh
# Turnstile; quá 150 → tạm chặn; mỗi IP xin tối đa 12 vé / giờ.
LIST_THROTTLE_SOFT=
LIST_THROTTLE_HARD=
LIST_GATE_PER_IP=
# Đặt 1 khi domain đi qua Cloudflare (proxy bật): lấy IP người dùng từ CF-Connecting-IP.
TRUST_CF_IP=

# Google Analytics 4 (để trống = chỉ log ra console khi dev)
NEXT_PUBLIC_GA_ID=

# Email hiện ở trang Liên hệ (để trống = chỉ đường sang form yêu cầu ẩn/sửa)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_ADS_EMAIL=
# Hiện dòng «Bản nháp…» trên trang tĩnh (chỉ bật ở môi trường duyệt nội dung)
NEXT_PUBLIC_SHOW_DRAFT_NOTE=
